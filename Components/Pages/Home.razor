@page "/"
@implements IDisposable
@inject IWebHostEnvironment HostEnvironment

<PageTitle>Happy birthday, Erumaaa 💜</PageTitle>

<main class="birthday-page">
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>
    <div class="star-field" aria-hidden="true">
        <span>✦</span><span>✧</span><span>✦</span><span>✧</span><span>✦</span>
    </div>

    @* These finite decorative animations start with the initial page render. *@
    <div class="arrival-celebration" aria-hidden="true">
        @for (var index = 0; index < 8; index++)
        {
            <div class="balloon-flight" style="--i: @index;">
                <span class="party-balloon"></span>
            </div>
        }
        @for (var side = 0; side < 2; side++)
        {
            <div class="party-popper" style="--side: @side;">
                <span class="party-popper-icon">🎉</span>
                <span class="party-burst-ring"></span>
                <div class="party-confetti">
                    @for (var piece = 0; piece < 24; piece++)
                    {
                        <span class="confetti-piece" style="--i: @piece;"></span>
                    }
                </div>
            </div>
        }
    </div>

    <div class="page-shell">
        <header class="top-bar">
            <a class="love-mark" href="#birthday" aria-label="Your birthday page">
                <span class="brand-heart" aria-hidden="true">♡</span>
                <span>just for you<span class="brand-dot">.</span></span>
            </a>
            <span class="occasion"><span aria-hidden="true">✧</span> your birthday edition</span>
        </header>

        <h2 class="forever-heading">
            ALWAYS AND FOREVER
            <span class="forever-symbols">
                <span class="maroon-heart" role="img" aria-label="maroon heart">&#x2665;&#xFE0E;</span>
                <span role="img" aria-label="infinity">&#x267E;&#xFE0F;</span>
            </span>
        </h2>

        <section id="birthday" class="hero" aria-labelledby="birthday-heading">
            <div class="greeting">
                <div class="eyebrow"><span class="eyebrow-line"></span> THE WORLD IS A LITTLE BRIGHTER TODAY</div>

                @* Layered text shadows create depth without needing a 3D library. *@
                <h1 id="birthday-heading" class="birthday-heading" aria-label="hey erumaaa happiessttttttt birthdayyyy">
                    <span class="hello-line">hey erumaaa</span>
                    <span class="birthday-word">happiessttttttt</span>
                    <span class="birthday-word birthday-last">birthdayyyy<span class="heading-star" aria-hidden="true">✧</span></span>
                </h1>

                <p class="intro">A tiny corner of the universe,<br />made a little more magical for you.</p>

                @if (introDismissed)
                {
                    <div class="action-area love-reveal">
                        @* The button is only rendered after the intro popup is dismissed. *@
                        <button type="button" class="surprise-button" @onclick="RevealMessage" data-love-button
                                aria-expanded="@messageVisible.ToString().ToLowerInvariant()" aria-controls="birthday-message">
                            <span class="button-heart" aria-hidden="true">♡</span>
                            <span>click me</span>
                            <span class="button-arrow" aria-hidden="true">↗</span>
                        </button>
                        <span class="button-hint">psst… there’s a little surprise inside</span>
                        <div class="reveal-hearts" aria-hidden="true">
                            @for (var index = 0; index < 8; index++)
                            {
                                <span style="--i: @index;">@(index % 2 == 0 ? "♡" : "♥")</span>
                            }
                        </div>

                        @if (celebrationCount > 0)
                        {
                            <div @key="celebrationCount" class="heart-burst" aria-hidden="true">
                                @for (var index = 0; index < 10; index++)
                                {
                                    <span style="--i: @index;">@(index % 2 == 0 ? "♡" : "✦")</span>
                                }
                            </div>
                        }
                    </div>
                }

                <div class="little-note"><span aria-hidden="true">✦</span> You make ordinary days feel extraordinary.</div>
            </div>

            <div class="photo-scene">
                <div class="photo-orbit orbit-one" aria-hidden="true"></div>
                <div class="photo-orbit orbit-two" aria-hidden="true"></div>
                <span class="floating-sparkle sparkle-one" aria-hidden="true">✦</span>
                <span class="floating-sparkle sparkle-two" aria-hidden="true">✧</span>
                <span class="floating-heart" aria-hidden="true">♡</span>

                <div class="photo-float">
                    <figure class="photo-card" data-tilt>
                        <div class="photo-tape" aria-hidden="true"></div>
                        <div class="photo-window">
                            @if (photoAvailable)
                            {
                                <img class="portrait" src="images/myphoto.jpg" alt="A favorite photo of the birthday girl"
                                     @onerror="ShowPhotoPlaceholder" />
                            }
                            else
                            {
                                <div class="photo-placeholder" role="img" aria-label="A heart illustration, waiting for your favorite photo">
                                    <div class="placeholder-ring ring-one" aria-hidden="true"></div>
                                    <div class="placeholder-ring ring-two" aria-hidden="true"></div>
                                    <span class="placeholder-sparkle" aria-hidden="true">✧</span>
                                    <span class="placeholder-heart" aria-hidden="true">♡</span>
                                    <span class="placeholder-caption">a beautiful memory<br />belongs here</span>
                                </div>
                            }
                            <span class="photo-corner-star" aria-hidden="true">✦</span>
                        </div>
                        <figcaption>
                            <span>my favorite person</span>
                            <span class="caption-heart" aria-hidden="true">♡</span>
                        </figcaption>
                    </figure>
                </div>

                <div class="birthday-seal" aria-label="One of a kind, always">
                    <span>ONE OF A KIND</span>
                    <span class="seal-heart" aria-hidden="true">♥</span>
                    <span>always & forever</span>
                </div>
                <span class="photo-annotation">the reason for all this magic <span aria-hidden="true">⤴</span></span>
            </div>
        </section>

        @* Keep this live region mounted so assistive technology can announce the reveal. *@
        <div id="birthday-message" class="message-region" aria-live="polite" aria-atomic="true">
            @if (messageVisible)
            {
                <section class="message-card" aria-labelledby="message-heading" data-message-card tabindex="-1">
                    <span class="message-decoration" aria-hidden="true">♡</span>
                    <button type="button" class="close-message" @onclick="HideMessage" aria-label="Close the birthday message">×</button>
                    <div class="eyebrow message-eyebrow">A LITTLE NOTE, JUST FOR YOU</div>
                    <h2 id="message-heading">With all my love<span aria-hidden="true">.</span></h2>
                    <p class="personal-message">@BirthdayMessage</p>
                    <div class="message-signature"><span aria-hidden="true">♡</span> yours, always</div>
                    <button type="button" class="surprise-button letter-close-button" @onclick="HideMessage">
                        <span>close the message</span>
                        <span aria-hidden="true">♡</span>
                    </button>
                </section>
            }
        </div>

        <footer class="page-footer">
            <span>made with love <span aria-hidden="true">♡</span></span>
            <span>a whole lot of purple. a whole lot of you.</span>
        </footer>
    </div>

    @if (introVisible)
    {
        @* The native dialog gives us a modal backdrop and traps keyboard focus. *@
        <dialog class="intro-popup" data-intro-popup aria-modal="true"
                aria-labelledby="intro-heading" aria-describedby="intro-text">
            <button type="button" class="close-message intro-close" @onclick="DismissIntro"
                    data-intro-close autofocus aria-label="Close the popup and reveal the click me button">×</button>
            <div class="intro-popup-heart" aria-hidden="true">♡</div>
            <div class="eyebrow intro-eyebrow">A LITTLE MORE LOVE</div>
            <h2 id="intro-heading">......ena rendu line la mudichuten nu nenachiya,......</h2>
            <p id="intro-text">intha cancel icon click pannitu, click me button press pannu....</p>
            <div class="intro-popup-stars" aria-hidden="true">✧ &nbsp; ♡ &nbsp; ✧</div>
        </dialog>
    }

    @if (farewellVisible)
    {
        <dialog class="intro-popup farewell-popup" data-farewell-popup aria-modal="true"
                aria-labelledby="farewell-heading" aria-describedby="farewell-text">
            <button type="button" class="close-message intro-close" @onclick="DismissFarewell"
                    data-farewell-close autofocus aria-label="Close the birthday celebration popup">×</button>
            <div class="farewell-smile" aria-hidden="true">
                <span>😁</span>
                <span class="maroon-heart">&#x2665;&#xFE0E;</span>
            </div>
            <div class="eyebrow intro-eyebrow">ALL THE LOVE, JUST FOR YOU</div>
            <h2 id="farewell-heading">seri seriii</h2>
            <p id="farewell-text">message eh padichutu confuse aagama bday va enjoyyyyyyy pannuuuu 😁 <span class="maroon-heart" role="img" aria-label="maroon heart">&#x2665;&#xFE0E;</span></p>
            <div class="intro-popup-stars farewell-stars" aria-hidden="true">♡ &nbsp; ✧ &nbsp; ♡</div>
        </dialog>
    }
</main>

<style>
    .birthday-page {
        position: relative;
        min-height: 100vh;
        min-height: 100svh;
        overflow: hidden;
        isolation: isolate;
        color: #f7edff;
        background: radial-gradient(ellipse at 78% 35%, #49265b 0%, transparent 48%),
                    radial-gradient(ellipse at 12% 70%, #36214b 0%, transparent 52%), #1c102c;
    }
    .birthday-page::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        opacity: .22;
        background-image: radial-gradient(#d8b9ee .65px, transparent .65px);
        background-size: 28px 28px;
        mask-image: linear-gradient(transparent, #000 40%, transparent);
        pointer-events: none;
    }
    .ambient { position: absolute; z-index: -1; border-radius: 50%; filter: blur(85px); pointer-events: none; }
    .ambient-one { width: 330px; height: 330px; background: #9a55bf; opacity: .13; top: -180px; left: 28%; }
    .ambient-two { width: 320px; height: 320px; background: #9c68d8; opacity: .12; right: -190px; bottom: 0; }
    .arrival-celebration { position: fixed; inset: 0; z-index: 5; overflow: hidden; pointer-events: none; animation: arrival-finish 10s step-end forwards; }
    .balloon-flight { position: absolute; bottom: -140px; left: calc(4% + var(--i) * 13%); --balloon-color: #bb87eb; --drift: 32px; animation: balloon-rise 7.3s ease-in both; animation-delay: calc(var(--i) * 180ms); }
    .balloon-flight:nth-child(4n + 2) { --balloon-color: #e2a5d9; --drift: -36px; }
    .balloon-flight:nth-child(4n + 3) { --balloon-color: #d1b2ff; --drift: 45px; }
    .balloon-flight:nth-child(4n + 4) { --balloon-color: #efcf9e; --drift: -25px; }
    .party-balloon { position: relative; display: block; width: clamp(36px, 4.6vw, 64px); aspect-ratio: 4 / 5; border-radius: 50% 50% 46% 46%; background: radial-gradient(ellipse at 30% 24%, #ffffffaa, transparent 35%), radial-gradient(ellipse at 35% 30%, var(--balloon-color) 45%, #5a2e7770), var(--balloon-color); box-shadow: inset -7px -8px 13px #35104755, inset 2px 2px 6px #ffffff50, 3px 8px 20px #12051b30; }
    .party-balloon::before { content: ''; position: absolute; bottom: -6px; left: calc(50% - 5px); width: 10px; height: 9px; background: var(--balloon-color); clip-path: polygon(50% 0, 100% 100%, 0 100%); }
    .party-balloon::after { content: ''; position: absolute; top: calc(100% + 4px); left: 50%; width: 21px; height: 68px; border-left: 1px solid #efddff80; border-radius: 50%; }
    .party-popper { position: absolute; bottom: 18%; left: calc(8% + var(--side) * 84%); --burst-delay: calc(150ms + var(--side) * 700ms); }
    .party-popper-icon { position: absolute; font-size: 49px; line-height: 1; filter: drop-shadow(0 5px 0 #673481) drop-shadow(0 9px 14px #16072166); animation: popper-pop 1.2s ease-out both; animation-delay: var(--burst-delay); }
    .party-burst-ring { position: absolute; left: -25px; top: -25px; width: 50px; height: 50px; border: 2px solid #edc7ff; border-radius: 50%; box-shadow: 0 0 16px #d399f755; animation: party-ring 1.2s ease-out both; animation-delay: var(--burst-delay); }
    .party-confetti { position: absolute; left: 0; top: 0; }
    .confetti-piece { position: absolute; width: 8px; height: 14px; border-radius: 2px; background: #d9b0ff; opacity: 0; --angle: calc(var(--i) * 15deg); --distance: calc(140px + var(--i) * 7px); animation: party-burst 2.5s ease-out both; animation-delay: calc(var(--burst-delay) + var(--i) * 12ms); }
    .confetti-piece:nth-child(3n + 2) { background: #efb5d9; border-radius: 50%; }
    .confetti-piece:nth-child(3n + 3) { background: #ffe2b2; width: 6px; }
    .page-shell { max-width: 1440px; margin: 0 auto; padding: 0 6.1%; position: relative; }
    .top-bar { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 38px 0 28px; }
    .love-mark { display: inline-flex; align-items: center; gap: 11px; text-decoration: none; color: #f7edff; font-size: 20px; font-weight: 650; letter-spacing: -.6px; }
    .brand-heart { color: #dcadff; font-size: 32px; line-height: 1; }
    .brand-dot { color: #c493ed; }
    .occasion { display: flex; gap: 9px; align-items: center; color: #d0b9df; font-size: 12px; letter-spacing: 1px; }
    .occasion > span { color: #e4b8ff; font-size: 21px; }
    .forever-heading { margin: 16px 0 0; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(30px, 5vw, 72px); font-weight: 700; line-height: 1.2; letter-spacing: .03em; text-align: center; }
    .forever-symbols { display: inline-block; white-space: nowrap; }
    .forever-heading .maroon-heart { text-shadow: 0 0 2px #efb5d9; }
    .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr); align-items: center; gap: 38px; min-height: 680px; padding: 42px 0 72px; }
    .greeting { position: relative; z-index: 2; min-width: 0; }
    .eyebrow { display: flex; align-items: center; gap: 12px; font-size: 10px; font-weight: 650; letter-spacing: 2.1px; line-height: 1.7; color: #d2acdF; }
    .eyebrow-line { width: 30px; height: 1px; flex-shrink: 0; background: #cda2e8; }
    .birthday-heading { margin: 24px 0 25px; font-family: Georgia, 'Times New Roman', serif; font-weight: 400; letter-spacing: -3.5px; line-height: 1.13; perspective: 800px; }
    .hello-line { display: block; color: #f8efff; font-size: clamp(35px, 3.6vw, 50px); letter-spacing: -1.8px; margin-bottom: 10px; font-style: italic; }
    .birthday-word {
        display: block;
        position: relative;
        width: fit-content;
        max-width: 100%;
        color: #eac7ff;
        font-size: clamp(40px, 5.2vw, 75px);
        text-shadow: 0 1px 0 #b789d0, 0 2px 0 #a676c2, 0 3px 0 #9160ac,
                     0 4px 0 #774992, 0 7px 0 #4c2b62, 0 13px 22px #0c061980;
        transform: rotateY(-5deg) rotateX(5deg);
        transform-origin: left center;
        transition: transform .45s ease, text-shadow .45s ease;
    }
    .birthday-heading:hover .birthday-word { transform: rotateY(0deg) rotateX(0deg) translateY(-3px); }
    .birthday-last { color: #f8edff; font-style: italic; font-size: clamp(47px, 5.8vw, 83px); }
    .heading-star { display: inline-block; color: #d7a8f4; font-size: .48em; vertical-align: top; margin: 4px 0 0 12px; text-shadow: none; }
    .intro { margin: 0 0 32px; color: #d1bfdc; font-size: 15px; line-height: 1.9; letter-spacing: .2px; }
    .action-area { position: relative; display: flex; align-items: flex-start; flex-direction: column; width: fit-content; }
    .love-reveal { animation: love-arrive .8s cubic-bezier(.2,.8,.2,1) both; }
    .love-reveal .surprise-button::after { content: ''; position: absolute; inset: -6px; border: 1px solid #edbcff99; border-radius: 22px; pointer-events: none; animation: love-ring 2s ease-out 3; }
    .reveal-hearts { position: absolute; inset: 0; pointer-events: none; }
    .reveal-hearts > span { position: absolute; left: calc(8% + var(--i) * 12%); top: 12px; color: #efc5ff; font-size: 23px; opacity: 0; text-shadow: 0 0 16px #dfa9ff99; animation: love-rise 1.9s ease-out both; animation-delay: calc(var(--i) * 85ms); }
    .surprise-button {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 20px;
        min-height: 60px;
        padding: 0 28px;
        border: 1px solid #f6e1ff99;
        border-radius: 16px;
        color: #34144b;
        background: linear-gradient(130deg, #eed8ff 0%, #d5a7f3 60%, #c799ef 100%);
        font-size: 17px;
        font-weight: 750;
        letter-spacing: .1px;
        box-shadow: 0 5px 0 #82509f, 0 7px 0 #4c2a62, 0 15px 32px #0c061950, inset 0 1px 0 #ffffff80;
        cursor: pointer;
        transform: perspective(600px) rotateX(5deg);
        transition: transform .2s ease, box-shadow .2s ease;
    }
    .surprise-button:hover { transform: perspective(600px) rotateX(0deg) translateY(-5px); box-shadow: 0 9px 0 #82509f, 0 11px 0 #4c2a62, 0 22px 38px #a676c230; }
    .surprise-button:active { transform: translateY(4px); box-shadow: 0 1px 0 #82509f, 0 4px 12px #0c061950; }
    .button-heart { font-size: 28px; line-height: 1; font-weight: 400; }
    .button-arrow { font-size: 23px; font-weight: 400; margin-left: 10px; }
    .button-hint { margin-top: 17px; color: #cfb5df; font-size: 11px; letter-spacing: .2px; }
    .little-note { margin-top: 38px; display: flex; align-items: center; gap: 9px; color: #bea7cc; font-size: 11px; letter-spacing: .25px; }
    .little-note > span { color: #d5a4ef; font-size: 17px; }
    .photo-scene { position: relative; min-width: 0; min-height: 500px; display: flex; align-items: center; justify-content: center; perspective: 1100px; }
    .photo-orbit { position: absolute; width: 410px; height: 410px; border: 1px solid #d2a0ee1c; border-radius: 50%; pointer-events: none; }
    .orbit-one { transform: rotate(-25deg) scaleX(1.13); }
    .orbit-two { width: 465px; height: 465px; transform: rotate(24deg) scaleX(.94); border-style: dashed; opacity: .55; }
    .photo-float { width: min(100%, 720px); z-index: 1; animation: photo-float 6s ease-in-out infinite; }
    .photo-card {
        --tilt-x: 0deg;
        --tilt-y: 0deg;
        --shine-x: 50%;
        --shine-y: 30%;
        position: relative;
        margin: 0;
        padding: 14px 14px 0;
        border: 1px solid #f9eeff;
        border-radius: 5px;
        color: #49315a;
        background: linear-gradient(145deg, #fff8ff, #e4d3ee);
        box-shadow: 3px 5px 0 #baa0cc, 6px 9px 0 #70557f, 10px 22px 55px #0a051b80;
        transform: rotate(-7deg) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
        transform-style: preserve-3d;
        transition: transform .35s ease;
    }
    .photo-card::after { content: ''; position: absolute; inset: 0; border-radius: inherit; background: radial-gradient(circle at var(--shine-x) var(--shine-y), #ffffff35, transparent 60%); pointer-events: none; }
    .photo-tape { position: absolute; left: 34%; top: -15px; width: 100px; height: 31px; z-index: 3; background: #d5ade6a8; border-left: 2px dashed #c9a2e05c; border-right: 2px dashed #c9a2e05c; transform: translateZ(20px) rotate(4deg); backdrop-filter: blur(3px); }
    .photo-window { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #664282; border-radius: 2px; }
    .portrait { position: absolute; inset: 0; width: 100%; height: 100%; display: block; object-fit: contain; object-position: center; }
    .photo-placeholder { position: relative; width: 100%; height: 100%; overflow: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center; background: radial-gradient(circle at 32% 30%, #af81ca, #775091 50%, #4b2b66); }
    .placeholder-ring { position: absolute; width: 230px; height: 230px; border: 1px solid #eac6ff32; border-radius: 50%; }
    .ring-one { transform: rotate(-35deg) scaleX(.75); }
    .ring-two { transform: rotate(35deg) scaleX(.75); }
    .placeholder-heart { position: relative; font-family: Georgia, serif; font-size: 130px; line-height: 1; color: #e8c5f8; text-shadow: 0 3px 0 #ad76c2, 0 6px 0 #75428e, 0 16px 30px #21103370; transform: rotate(-8deg); }
    .placeholder-sparkle { position: absolute; top: 15%; right: 17%; color: #f2d8ff; font-size: 34px; }
    .placeholder-caption { z-index: 1; margin-top: 20px; color: #f2e0fc; font-family: Georgia, serif; font-style: italic; text-align: center; font-size: 19px; line-height: 1.5; }
    .photo-corner-star { position: absolute; bottom: 16px; right: 19px; color: #f0d5ff; font-size: 24px; }
    .photo-card figcaption { display: flex; align-items: center; justify-content: space-between; padding: 18px 8px 21px; font-family: Georgia, serif; font-style: italic; font-size: 22px; }
    .caption-heart { color: #8b5b9f; font-size: 29px; line-height: 1; }
    .floating-sparkle, .floating-heart { position: absolute; z-index: 2; pointer-events: none; text-shadow: 0 0 25px #d4a1ee44; }
    .sparkle-one { left: 0; top: 23%; color: #d8aff1; font-size: 39px; animation: sparkle 4s ease-in-out infinite; }
    .sparkle-two { right: 2%; top: 4%; color: #f0d3ff; font-size: 56px; animation: sparkle 5s ease-in-out infinite .6s; }
    .floating-heart { right: -3%; bottom: 26%; color: #ba87d3; font-size: 40px; transform: rotate(15deg); }
    .birthday-seal { position: absolute; z-index: 3; right: -6px; bottom: 30px; width: 119px; height: 119px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px; border: 1px solid #f4d8ffb3; border-radius: 50%; outline: 1px solid #bc8ec0; outline-offset: -7px; background: linear-gradient(145deg, #e6c2f1, #c79bd9); color: #512665; box-shadow: 0 5px 0 #9266a3, 0 13px 25px #15082155; transform: rotate(12deg); }
    .birthday-seal > span:first-child { font-size: 9px; font-weight: 750; letter-spacing: 1.2px; }
    .seal-heart { font-size: 27px; line-height: 1; }
    .birthday-seal > span:last-child { font-family: Georgia, serif; font-size: 12px; font-style: italic; }
    .photo-annotation { position: absolute; bottom: -16px; left: 4%; color: #d2b9df; font-family: Georgia, serif; font-style: italic; font-size: 15px; transform: rotate(-4deg); }
    .photo-annotation > span { display: inline-block; font-size: 40px; line-height: .8; vertical-align: middle; margin-left: 7px; }
    .star-field { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
    .star-field > span { position: absolute; color: #cf9eea; opacity: .5; font-size: 16px; }
    .star-field > span:nth-child(1) { top: 19%; left: 3%; }
    .star-field > span:nth-child(2) { top: 14%; left: 49%; font-size: 24px; }
    .star-field > span:nth-child(3) { top: 69%; left: 45%; font-size: 11px; }
    .star-field > span:nth-child(4) { top: 82%; right: 3%; font-size: 20px; }
