    protected override void OnInitialized()
    {
        // Add wwwroot/images/myphoto.jpg, then reload the page to show it.
        photoAvailable = !string.IsNullOrEmpty(HostEnvironment.WebRootPath)
            && System.IO.File.Exists(System.IO.Path.Combine(HostEnvironment.WebRootPath, "images", "myphoto.jpg"));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Start once after interactive rendering, rather than during server prerendering.
        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(4000), introDelay.Token);
            await InvokeAsync(() =>
            {
                if (disposed)
                {
                    return;
                }

                introVisible = true;
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) when (introDelay.IsCancellationRequested)
        {
            // Navigating away cancels the pending popup.
        }
    }

